{
  "name": "notes",
  "version": "0.1.0",
  "description": "Local-first, Git-native, agent-friendly knowledge management",
  "type": "module",
  "private": true,
  "bin": {
    "notes": "./bin/notes"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/interfaces/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "compile": "bun scripts/compile.ts --host",
    "compile:all": "bun scripts/compile.ts",
    "load": "bun run compile && install -m 755 release/notes-linux-x64 ~/.local/bin/notes"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chokidar": "^6.0.0",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tinyglobby": "^0.2.17",
    "ulid": "^3.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "unist-util-visit-parents": "^6.1.0",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
